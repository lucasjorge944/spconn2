{
  "name": "desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Shell Electron para o renderer",
  "main": "main.js",
  "author": "SPCE",
  "homepage": "https://github.com/spce/spce",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k -n vite,electron -c blue,magenta \"yarn --cwd ../renderer dev\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build:renderer": "yarn --cwd ../renderer build",
    "build:desktop": "electron-builder",
    "build:linux": "electron-builder --linux",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:release": "yarn build:renderer && yarn --cwd ../shared build && yarn build:desktop",
    "build:release:linux": "yarn build:renderer && yarn --cwd ../shared build && yarn build:linux",
    "build:release:win": "yarn build:renderer && yarn --cwd ../shared build && yarn build:win",
    "build:release:mac": "yarn build:renderer && yarn --cwd ../shared build && yarn build:mac"
  },
  "dependencies": {
    "@spce/shared": "portal:../shared"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "cross-env": "^7.0.3",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "dev.spce.desktop",
    "productName": "SPCE",
    "copyright": "Copyright © SPCE",
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**",
      {
        "from": "../renderer/dist",
        "to": "renderer/dist",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../jdbc-sidecar/target/jdbc-sidecar.jar",
        "to": "sidecar/jdbc-sidecar.jar"
      }
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "maintainer": "SPCE"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
